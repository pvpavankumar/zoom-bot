# Environment Configuration
ENVIRONMENT=development

# Zoom API Configuration
ZOOM_API_KEY=your_zoom_api_key_here
ZOOM_API_SECRET=your_zoom_api_secret_here
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret_here
ZOOM_SDK_KEY=your_zoom_sdk_key_here
ZOOM_SDK_SECRET=your_zoom_sdk_secret_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ORG_ID=your_openai_org_id_here  # Optional - only needed for organization accounts
OPENAI_MODEL=gpt-4

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zoom_bot_db

# Audio Processing Configuration (MODERN STACK - NO PYAUDIO)
ENABLE_AUDIO_PROCESSING=true
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024
AUDIO_FORMAT=wav
SPEECH_RECOGNITION_TIMEOUT=5
VOICE_ACTIVITY_DETECTION_THRESHOLD=0.6

# Enhanced Audio Settings (SoundDevice-based)
AUDIO_BUFFER_DURATION=3.0
MIN_SPEECH_DURATION=0.5
MAX_SILENCE_DURATION=2.0
SPEECH_END_TIMEOUT=1.5
AUDIO_DEVICE_INDEX=None  # None for default, or specific device index

# Bot Configuration
BOT_NAME=InterviewBot
BOT_DISPLAY_NAME=AI Interview Assistant
BOT_HIDDEN_MODE=true
MAX_CONCURRENT_ROOMS=10
SUGGESTION_FREQUENCY=30
CONTEXT_WINDOW_SIZE=1000

# Testing Configuration
RUN_STARTUP_TESTS=true
SKIP_TESTS_ON_FAILURE=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/zoom_bot.log
SENTRY_DSN=your_sentry_dsn_here

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# Monitoring Configuration
PROMETHEUS_PORT=8001
HEALTH_CHECK_INTERVAL=30

# Development Configuration
DEBUG=true
RELOAD=true
HOST=localhost
PORT=8000
